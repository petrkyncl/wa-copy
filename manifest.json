{
  "manifest_version": 3,
  "name": "WA Copy",
  "version": "0.1.0",
  "description": "Rychlé kopírování zpráv z WhatsApp Web — jedna zpráva nebo rozsah přes Shift, s časem a odesílatelem.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
